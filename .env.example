# Metistry environment — copy to <instance>/state/.env and fill in.
# Everything configurable lives here or in identity.yaml; nothing is
# hardcoded (cloud-portable rule).
#
# WHERE THIS FILE GOES: an instance directory is self-contained, so an
# install's environment is `$METISTRY_INSTANCE_DIR/state/.env` (gitignored,
# 0600) — not the product checkout. A checkout `.env` is still read as a
# deprecated fallback, and is where a terminal install may keep declaring
# METISTRY_INSTANCE_DIR; `metistry secrets sync --to env` moves the rest.
# docs/ops/cli.md, "Instance directories are self-contained".

# --- database (docker compose service: db) ---
METISTRY_DB_HOST=127.0.0.1
METISTRY_DB_PORT=5432
METISTRY_DB_NAME=metistry
METISTRY_DB_USER=metistry
METISTRY_DB_PASSWORD=change-me

# --- deployment profile: local-mac | cloud ---
METISTRY_PROFILE=local-mac

# --- assistant container auth (Phase 2) ---
# Mint with `claude setup-token` on the host; inject at runtime, never bake
# into an image. NEVER set ANTHROPIC_API_KEY in the assistant container — it
# silently overrides subscription billing.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- cli (docs/ops/cli.md) ---
# `metistry connect-repo --auth device`: the PUBLIC client id of a GitHub
# OAuth App you register once (Settings -> Developer settings -> OAuth Apps,
# then tick "Enable Device Flow"). A device-flow app has no client secret,
# which is why this can live in a config file at all. Unset = use
# --auth token (a PAT on stdin) or --auth ssh.
# Defaults to Folded Space Labs' app (Ov23lid9DItZlts5e5GV); set your own to override.
# METISTRY_GITHUB_OAUTH_CLIENT_ID=
# `metistry secrets`: the PER-USER login-Keychain account (service names are
# metistry:<VAR>). Only user-scoped secrets are filed under it —
# CLAUDE_CODE_OAUTH_TOKEN and your own AWS keys — and they are shared by
# every instance on this Mac deliberately. Everything else is filed under
# the instance's own instance_id, which is what keeps two instances apart
# (secrets.ts SECRET_SCOPES; docs/ops/cli.md).
# METISTRY_KEYCHAIN_ACCOUNT=metistry
# Where `metistry init`/`doctor` find seed/ and the manifests when not run
# from inside a checkout (also --product-dir). Unset = the checkout this
# package is installed in, else the current directory's enclosing checkout.
# METISTRY_PRODUCT_DIR=/path/to/metistry

# --- assistant tools (Phase 5; docs/ops/assistant-tools.md) ---
# The assistant is the first INTERNAL agent on the console's /mcp (mcp-brain).
# One shared secret, read by BOTH containers: the console registers agent
# 'assistant' with its hash at startup; the assistant presents it as a
# bearer. Generate: openssl rand -hex 32. Unset = the agent is revoked and
# the assistant runs tool-less.
# METISTRY_ASSISTANT_TOKEN=
# Where the assistant reaches mcp-brain (compose default: the console service).
# METISTRY_BRAIN_URL=http://console:8080/mcp
# Project membership, comma-separated slugs. EMPTY = every project (the
# internal rule in mcp-brain); a list narrows it like any other agent.
# METISTRY_ASSISTANT_PROJECTS=
# Knowledge read grant, comma-separated TitleCase Knowledge/ prefixes.
# Default = every note-bearing top-level folder of plan §4.15 (the widest
# grant the validator admits — bare Knowledge/ is refused by design).
# METISTRY_ASSISTANT_AREAS=Knowledge/Areas,Knowledge/Projects,Knowledge/Resources,Knowledge/Techniques,Knowledge/Journal,Knowledge/People,Knowledge/Me
# compute.yaml — providers, assignments and budgets (docs/ops/compute.md).
# D4 overlay, colon-separated, LAST EXISTING FILE WINS WHOLE. Point the
# second entry at this instance's own file; both the console and the
# assistant watch it and reload without a restart.
# METISTRY_COMPUTE_FILES=seed/compute.yaml:/path/to/instance/compute.yaml
# Identity + system-prompt seed overlays (D4: colon-separated, last existing wins).
# METISTRY_IDENTITY_FILES=seed/identity.yaml:identity.yaml
# METISTRY_PROMPT_FILES=seed/assistant-prompt.md:assistant-prompt.md
# Agentic turns per message when tools are mounted (default 12; 4 tool-less).
# METISTRY_MAX_TURNS=12

# --- bridge endpoints (Phase 2; containers reach the host explicitly) ---
# METISTRY_BRIDGE_MESSAGES_URL=http://host.docker.internal:7801/mcp

# --- watchdog (PoC-11 shape; set to your own iMessage handle) ---
# METISTRY_WATCHDOG_SELF=+15555550100

# Console (Phase 2 web door)
# Canonical HTTPS origin passkeys + service worker bind to (§4.2). A
# comma-separated LIST is accepted when one install is loaded under more
# than one origin; the FIRST is canonical (rpID, enrolled passkeys).
METISTRY_ORIGIN=https://your-hostname.example
# The LOCAL owner token (docs/ops/auth.md). `metistry init` mints it and
# `metistry secrets sync --to env` mints one for an install that predates
# it; the Keychain is its home. Presented as `Authorization: Bearer …` over
# a connection FROM THIS MACHINE it authenticates as the `user` principal —
# the same principal a passkey session yields — and is refused (401, with an
# audit line) from every other address. Unset = passkeys only.
METISTRY_LOCAL_OWNER_TOKEN=
# How a console in a container is told that host-loopback traffic reaches it
# NATed. docker-compose.yml sets `docker-gateway` (this container's own
# default gateway, resolved at startup); an explicit address or IPv4 CIDR
# also works. NEVER set it on the launchd shape, where loopback is loopback.
# METISTRY_TRUSTED_LOOPBACK_PROXY=docker-gateway
METISTRY_CONSOLE_HOST=127.0.0.1
METISTRY_CONSOLE_PORT=8080
METISTRY_INBOX_DIR=./inbox
METISTRY_QUERIES_DIRS=seed/queries
METISTRY_SESSION_IDLE_DAYS=30
METISTRY_SESSION_MAX_DAYS=365
# Web push (PoC-6): generate with `npx web-push generate-vapid-keys`.
# Subject must be a REAL mailto: contact — Apple rejects placeholders.
METISTRY_VAPID_PUBLIC=
METISTRY_VAPID_PRIVATE=
METISTRY_VAPID_SUBJECT=

# Runner hardening (console; docs/ops/automation.md). Consecutive failed runs
# after which a collector/routine stops being run until it succeeds again —
# the runs row recording each skipped window names this variable. And how long
# one (component, error signature) stays quiet after raising a Needs You item;
# a changed signature, or a streak that cleared and came back, speaks at once.
# METISTRY_RUNNER_MAX_STREAK=5
# METISTRY_ALERT_DEDUPE_H=24

# The two limits an install may genuinely need to move (ops/scripts/audit-limits.mjs
# holds every other cap to being read from config or annotated as fixed on purpose).
# Largest request body the console will read — raise it if `capture` sends bigger:
# METISTRY_MAX_BODY_BYTES=33554432
# How long `metistry up` waits on `docker compose` — a cold --build compiles two
# images, and a slow machine wants more than half an hour:
# METISTRY_COMPOSE_TIMEOUT_MS=1800000

# Watchdog (host-run, model-free — ops/launchd plist template)
METISTRY_CONSOLE_URL=http://127.0.0.1:8080
METISTRY_WATCHDOG_INTERVAL_SEC=60
METISTRY_WATCHDOG_HOURLY_USD=5
# silent-collector: alert when a collector/routine has no runs row within
# N × its manifest interval (manifests read from METISTRY_COLLECTORS_DIR /
# METISTRY_ROUTINES_DIR, default collectors/ + routines/ in the checkout)
METISTRY_WATCHDOG_SILENCE_FACTOR=3
# fm-tier-never-fires: apple-fm healthy but inbox-drain never uses it —
# needs this many rule-default captures in the window before it speaks
METISTRY_WATCHDOG_FM_MIN_CAPTURES=5
METISTRY_WATCHDOG_FM_WINDOW_HOURS=24
# bridge-degraded probes every bridge URL below (host.docker.internal is
# rewritten to loopback — the watchdog is on the host). Reconciler: unset
# until that service ships.
#METISTRY_RECONCILER_URL=http://127.0.0.1:7812
#METISTRY_BRIDGE_TOKEN_RECONCILER=
# apple-fm host bridge (free on-device classification; degrades absent)
METISTRY_AFM_URL=http://host.docker.internal:7810
METISTRY_BRIDGE_TOKEN_APPLE_FM=
# eventkit host bridge (Calendar + Reminders; TCC-bound; degrades absent)
METISTRY_EK_URL=http://host.docker.internal:7811
METISTRY_BRIDGE_TOKEN_EVENTKIT=
# reconciler (host-run; D5 sole committer + vault bridge — docs/ops/reconciler.md).
# The instance repo's working tree: the ONLY process that holds it or runs git.
METISTRY_INSTANCE_DIR=/path/to/your-instance-repo
METISTRY_RECONCILER_HOST=127.0.0.1
METISTRY_RECONCILER_PORT=7812
# bearer every caller must present (mint: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
METISTRY_BRIDGE_TOKEN_RECONCILER=
# how the console (in its container) reaches the bridge; degrades absent when unset
METISTRY_RECONCILER_URL=http://host.docker.internal:7812
METISTRY_COMMIT_INTERVAL_SEC=30
METISTRY_RECONCILE_INTERVAL_SEC=300
# @hourly | @daily | never | <n>[s|m|h]; pushes only if the repo has a remote, never blocks on failure
METISTRY_PUSH_SCHEDULE=@hourly
# commit author = "<name> <principal>" stamped server-side (e.g. "Metistry assistant")
METISTRY_GIT_AUTHOR_NAME=Metistry
METISTRY_GIT_AUTHOR_EMAIL=metistry@localhost
METISTRY_VAULT_MAX_BYTES=2097152
# sweep edits made outside the bridge (Obsidian on any device) into `user` commits
METISTRY_COMMIT_EXTERNAL_EDITS=true
# Timezone for brief/schedule rendering (until Me/profile.md drives it)
METISTRY_TZ=America/New_York
# github-state collector (degrades absent). Fine-grained PAT, read-only
# Issues + Pull requests + Metadata on the listed repos.
METISTRY_GITHUB_TOKEN=
METISTRY_GITHUB_REPOS=owner/repo,owner/repo2
# github-issues dispatch target (degrades absent; docs/ops/targets.md). A
# SEPARATE fine-grained PAT: Issues read/write + Metadata on the dispatch
# repo ONLY — never reuse the read token above. The dispatch repo must also
# appear in METISTRY_GITHUB_REPOS so github-state reconciles issues back.
METISTRY_GITHUB_WRITE_TOKEN=
METISTRY_GITHUB_DISPATCH_REPO=owner/repo
# Target manifests, colon-separated, later dirs override by name (D4 overlay)
METISTRY_TARGETS_DIRS=targets

# --- crews (Phase 5; docs/ops/crews.md) ---
# Crew manifests: agents/<area>/<name>.md, colon-separated dirs, later win by
# name. An entry not on disk is read through the reconciler's vault bridge
# (that is how the instance repo's protected agents/ reaches the console).
# METISTRY_AGENTS_DIRS=seed/agents:agents
# How often the console re-reads manifests and re-syncs the registry (seconds).
# METISTRY_CREWS_SYNC_S=300
# Runner (assistant container): claim lease per run, retries on infrastructure
# failure before a row parks as blocked, and the wait between retries.
# METISTRY_CREW_LEASE_S=1800
# METISTRY_CREW_MAX_ATTEMPTS=3
# METISTRY_CREW_RETRY_S=300
# aws-costs collector (degrades absent). An IAM user/role with ONLY
# ce:GetCostAndUsage; Cost Explorer bills $0.01 per request (4 runs/day).
METISTRY_AWS_ACCESS_KEY_ID=
METISTRY_AWS_SECRET_ACCESS_KEY=
METISTRY_AWS_SESSION_TOKEN=
# devin-knowledge collector (degrades absent; docs/ops/devin.md). A Devin
# `cog_` service-user key or personal access token — user-scoped in the
# Keychain, because it is the person's credential, not this instance's.
# Legacy `apk_` keys are rejected by Devin's MCP server.
METISTRY_DEVIN_API_KEY=
# Only needed when the token is account-scoped (an enterprise service-user
# key, or a PAT): `org-…` from Settings > Service users, or GET /v3/self.
METISTRY_DEVIN_ORG_ID=
# Opt-in wiki half: repos whose DeepWiki pages to pull, "owner/repo,owner/repo2".
# Empty = knowledge notes only.
METISTRY_DEVIN_REPOS=
# Cap per run, so a first pass on a large knowledge base cannot run away.
METISTRY_DEVIN_MAX_ITEMS=200

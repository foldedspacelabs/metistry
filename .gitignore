# dependencies / build
node_modules/
dist/
*.tsbuildinfo

# environment & secrets — config comes from env, never from committed files
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store

# logs
*.log
backups/
# built helper bundles (scripts/build-helper.sh) — build output is never tracked
packages/mcp-apple-fm/helper/afm-helper.app/
packages/mcp-eventkit/helper/ek-helper.app/

# release build output (ops/release/pack-runtime.sh); assets live on GitHub Releases
dist-release/

# macOS app build output: SwiftPM's tree, and the assembled Metistry.app / DMG
# (ops/release/build-app.sh). Package.resolved IS tracked — it is the pin.
apps/macos/.build/
dist-app/

# launchd shape (deployment.yaml): derived state and the bundled runtime.
# Postgres data and the assistant's SDK transcripts live under state/ —
# invariant 1: git is the record, this is regenerable.
state/
runtime/

# bundled-runtime build tree (ops/release/build-runtime-deps.sh): source
# tarballs and the per-version compile cache. `runtime/` above is its output.
.runtime-build/

# Sparkle CLI tools (ops/release/fetch-sparkle-tools.sh): the downloaded
# archive and the extracted bin/ — fetched on demand, never tracked.
ops/release/.tools/

# a release-channel install in this checkout (metistry update --channel release):
# the unpacked runtime packs and the `current` symlink. Never source.
releases/
current

# Claude Code: local session state and this repo's worktrees live under
# .claude/, but .claude/skills and .claude/agents ARE tracked — they are the
# source of truth that ops/scripts/install-claude-assets.sh links into ~/.claude.
.claude/settings.local.json
.claude/worktrees/

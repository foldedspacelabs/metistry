    "start": "node dist/main.js"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@foldedspacelabs/metistry-core": "workspace:*",
    "pg": "^8.16.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}

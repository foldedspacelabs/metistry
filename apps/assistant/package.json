{
  "name": "@metistry-apps/assistant",
  "private": true,
  "version": "0.4.0",
  "description": "Metistry assistant engine: Agent SDK host draining inbound messages, resuming sessions by thread. Ships as a container image.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",

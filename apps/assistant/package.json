    "chokidar": "^5.0.0",
    "pg": "^8.16.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.16.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}

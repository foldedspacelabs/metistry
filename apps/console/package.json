{
  "name": "@metistry-apps/console",
  "private": true,
  "version": "0.14.1",
  "description": "Metistry console: web door API (capture, message, status, named queries) + passkey owner auth. Ships as a container image, not npm.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "enroll": "node scripts/enroll.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@foldedspacelabs/metistry-artifacts": "workspace:*",
    "@foldedspacelabs/metistry-cli": "workspace:*",
    "@foldedspacelabs/metistry-connections": "workspace:*",
    "@foldedspacelabs/metistry-core": "workspace:*",
    "@foldedspacelabs/metistry-mcp-brain": "workspace:*",
    "@foldedspacelabs/metistry-queries": "workspace:*",
    "@foldedspacelabs/metistry-tasks": "workspace:*",
    "@metistry-apps/collectors": "workspace:*",
    "@metistry-apps/routines": "workspace:*",
    "chokidar": "^5.0.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "pg": "^8.16.0",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.16.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}

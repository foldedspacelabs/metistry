{
  "name": "@metistry-apps/console",
  "private": true,
  "version": "0.0.1",
  "description": "Metistry console: web door API (capture, message, status, named queries) + passkey owner auth. Ships as a container image, not npm.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "enroll": "node scripts/enroll.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@foldedspacelabs/metistry-core": "workspace:*",
    "@foldedspacelabs/metistry-queries": "workspace:*",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.2.2",
    "pg": "^8.16.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.16.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}

{
  "$schema": "https://foldedspacelabs.github.io/metistry/design-tokens.schema.json",
  "$meta": {
    "name": "metistry design tokens",
    "version": "1.0.0",
    "updated": "2026-09-08",
    "source": "docs/product/design-system.md",
    "generated": "docs/product/design/tokens.css is generated from this file by ops/scripts/build-design-tokens.mjs — edit the JSON, never the CSS",
    "prefix": "--mt-",
    "note": "Semantic roles only. No token names a hue, a screen, or a component; a role may be re-pointed without renaming a call site."
  },

  "color": {
    "bg": {
      "role": "the window canvas behind everything",
      "light": "#f6f7f9",
      "dark": "#0e1216",
      "apple": "systemGroupedBackground / windowBackgroundColor"
    },
    "surface": {
      "role": "rows, cards, composer, list backgrounds",
      "light": "#ffffff",
      "dark": "#171c22",
      "apple": "secondarySystemGroupedBackground / controlBackgroundColor"
    },
    "elevated": {
      "role": "menus, popovers, sheets, the command palette",
      "light": "#ffffff",
      "dark": "#212831",
      "apple": "tertiarySystemBackground / under an NSVisualEffectView"
    },
    "sunken": {
      "role": "code blocks, wells, inset scroll regions",
      "light": "#eef0f3",
      "dark": "#0b0e12",
      "apple": "systemFill"
    },
    "border": {
      "role": "separators between rows and around inputs",
      "light": "#d9dee4",
      "dark": "#2b333d",
      "apple": "separatorColor"
    },
    "border-strong": {
      "role": "focused input, selected row outline, table rules",
      "light": "#b6bec8",
      "dark": "#3d4854",
      "apple": "opaqueSeparatorColor"
    },
    "text-primary": {
      "role": "body copy, titles, values",
      "light": "#12171c",
      "dark": "#e9edf1",
      "apple": "labelColor",
      "contrast": ["bg", "surface", "elevated"]
    },
    "text-secondary": {
      "role": "metadata that must still be read: timestamps, counts, actor ids",
      "light": "#4d565f",
      "dark": "#a7b1bc",
      "apple": "secondaryLabelColor",
      "contrast": ["bg", "surface", "elevated"]
    },
    "text-tertiary": {
      "role": "placeholders and de-emphasised hints; never the only carrier of meaning",
      "light": "#646d77",
      "dark": "#8b96a1",
      "apple": "tertiaryLabelColor",
      "contrast": ["bg", "surface"]
    },
    "accent": {
      "role": "the one interactive colour: links, selected tab, primary button fill",
      "light": "#2b5fd0",
      "dark": "#7ea9ff",
      "apple": "controlAccentColor / tintColor",
      "contrast": ["bg", "surface"]
    },
    "accent-hover": {
      "role": "hover and pressed state of an accent surface",
      "light": "#234ea9",
      "dark": "#9dbeff"
    },
    "accent-quiet": {
      "role": "accent at low weight: selected sidebar row, chip fill, focus halo",
      "light": "#e6edfc",
      "dark": "#1b2739"
    },
    "on-accent": {
      "role": "text and glyphs on an accent fill",
      "light": "#ffffff",
      "dark": "#0b1220",
      "contrast": ["accent"]
    },
    "agent": {
      "role": "the agent-sourced tint — marks a string an agent wrote, as data",
      "light": "#6a4bbd",
      "dark": "#b9a2f5",
      "apple": "systemPurple",
      "contrast": ["bg", "surface"]
    },
    "agent-quiet": {
      "role": "agent-sourced background wash: quoted tool output, agent comment",
      "light": "#f1ecfc",
      "dark": "#1e1a2c"
    },
    "ok": {
      "role": "check passed, run succeeded, thread resolved",
      "light": "#1c7a45",
      "dark": "#68d391",
      "apple": "systemGreen",
      "contrast": ["bg", "surface"]
    },
    "degraded": {
      "role": "answering but not healthy: stale collector, fallback tier, queued over cap",
      "light": "#8a5a00",
      "dark": "#e8b84b",
      "apple": "systemOrange",
      "contrast": ["bg", "surface"]
    },
    "failed": {
      "role": "the check failed, the run errored, the drop was refused",
      "light": "#b3261e",
      "dark": "#f4837c",
      "apple": "systemRed",
      "contrast": ["bg", "surface"]
    },
    "absent": {
      "role": "not configured — a fact, not a fault (no VAPID keys, no AWS collector)",
      "light": "#646d77",
      "dark": "#8b96a1",
      "apple": "systemGray",
      "contrast": ["bg", "surface"]
    },
    "presence-working": {
      "role": "a live lease with evidence in the last interval",
      "light": "#1c7a45",
      "dark": "#68d391",
      "contrast": ["surface"]
    },
    "presence-queued": {
      "role": "work claimed or waiting behind the project's cap",
      "light": "#8a5a00",
      "dark": "#e8b84b",
      "contrast": ["surface"]
    },
    "presence-idle": {
      "role": "registered, reachable, nothing claimed",
      "light": "#646d77",
      "dark": "#8b96a1",
      "contrast": ["surface"]
    },
    "presence-interrupted": {
      "role": "lease expired mid-claim — the run stopped without saying so",
      "light": "#b3261e",
      "dark": "#f4837c",
      "contrast": ["surface"]
    },
    "presence-over-cap": {
      "role": "at max open bundles or over the daily budget",
      "light": "#a24a00",
      "dark": "#f0a35e",
      "contrast": ["surface"]
    },
    "presence-blocked": {
      "role": "waiting on a decision from you or on another agent",
      "light": "#6a4bbd",
      "dark": "#b9a2f5",
      "contrast": ["surface"]
    },
    "focus-ring": {
      "role": "keyboard focus indicator — 2px, always visible, never suppressed",
      "light": "#2b5fd0",
      "dark": "#7ea9ff",
      "contrast": ["bg", "surface"]
    },
    "scrim": {
      "role": "behind a sheet or modal",
      "light": "rgba(18, 23, 28, 0.32)",
      "dark": "rgba(0, 0, 0, 0.55)"
    }
  },

  "type": {
    "$meta": {
      "family": "SF on Apple platforms; on the web the system stack resolves to SF on Apple, Segoe UI Variable on Windows, Roboto on Android, Cantarell/Ubuntu on Linux. No webfont is ever loaded.",
      "stack": "-apple-system, BlinkMacSystemFont, system-ui, 'Segoe UI Variable Text', 'Segoe UI', Roboto, Cantarell, 'Helvetica Neue', sans-serif",
      "mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
    },
    "large-title": { "apple": "largeTitle", "pt": 34, "weight": 700, "line": 1.15, "clamp": "clamp(1.625rem, 1.35rem + 1.4vw, 2.125rem)", "tracking": "-0.02em" },
    "title-1": { "apple": "title", "pt": 28, "weight": 700, "line": 1.2, "clamp": "clamp(1.5rem, 1.32rem + 0.9vw, 1.75rem)", "tracking": "-0.015em" },
    "title-2": { "apple": "title2", "pt": 22, "weight": 600, "line": 1.25, "clamp": "clamp(1.25rem, 1.16rem + 0.45vw, 1.375rem)", "tracking": "-0.01em" },
    "title-3": { "apple": "title3", "pt": 20, "weight": 600, "line": 1.3, "clamp": "clamp(1.125rem, 1.08rem + 0.22vw, 1.25rem)", "tracking": "-0.005em" },
    "headline": { "apple": "headline", "pt": 17, "weight": 600, "line": 1.35, "clamp": "clamp(1rem, 0.98rem + 0.1vw, 1.0625rem)", "tracking": "0" },
    "body": { "apple": "body", "pt": 17, "weight": 400, "line": 1.5, "clamp": "clamp(1rem, 0.98rem + 0.1vw, 1.0625rem)", "tracking": "0" },
    "callout": { "apple": "callout", "pt": 16, "weight": 400, "line": 1.45, "clamp": "clamp(0.9375rem, 0.92rem + 0.1vw, 1rem)", "tracking": "0" },
    "subhead": { "apple": "subheadline", "pt": 15, "weight": 400, "line": 1.4, "clamp": "clamp(0.875rem, 0.86rem + 0.1vw, 0.9375rem)", "tracking": "0" },
    "footnote": { "apple": "footnote", "pt": 13, "weight": 400, "line": 1.4, "clamp": "clamp(0.8125rem, 0.8rem + 0.06vw, 0.8125rem)", "tracking": "0.005em" },
    "caption-1": { "apple": "caption", "pt": 12, "weight": 400, "line": 1.35, "clamp": "0.75rem", "tracking": "0.01em" },
    "caption-2": { "apple": "caption2", "pt": 11, "weight": 500, "line": 1.3, "clamp": "0.6875rem", "tracking": "0.02em" },
    "mono": { "apple": "body (monospaced)", "pt": 13, "weight": 400, "line": 1.5, "clamp": "0.8125rem", "tracking": "0" }
  },

  "space": {
    "$meta": { "grid": "4pt. Every gap, pad and inset is a multiple of 4; nothing in the system uses an odd number." },
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },

  "size": {
    "$meta": { "note": "Hit targets follow the HIG minimum of 44x44pt on touch; 28pt is the macOS pointer minimum." },
    "touch-target": "44px",
    "pointer-target": "28px",
    "icon-sm": "16px",
    "icon-md": "20px",
    "icon-lg": "24px",
    "sidebar": "248px",
    "reading-measure": "68ch",
    "content-max": "760px",
    "wide-breakpoint": "900px"
  },

  "radius": {
    "xs": "6px",
    "sm": "8px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "999px"
  },

  "elevation": {
    "$meta": {
      "note": "Dark mode raises a surface by lightening it, not by casting a bigger shadow (HIG Dark Mode). Every level therefore pairs a shadow with a surface token and a hairline."
    },
    "0": { "light": "none", "dark": "none", "use": "flat rows on the canvas" },
    "1": { "light": "0 1px 2px rgba(18,23,28,0.06), 0 0 0 1px rgba(18,23,28,0.05)", "dark": "0 0 0 1px rgba(255,255,255,0.05)", "use": "cards, feed groups, the composer" },
    "2": { "light": "0 4px 14px rgba(18,23,28,0.10), 0 0 0 1px rgba(18,23,28,0.06)", "dark": "0 4px 14px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.07)", "use": "menus, popovers, the command palette, the model picker" },
    "3": { "light": "0 18px 48px rgba(18,23,28,0.18)", "dark": "0 18px 48px rgba(0,0,0,0.65), 0 0 0 1px rgba(255,255,255,0.08)", "use": "sheets and modals over a scrim" }
  },

  "motion": {
    "$meta": {
      "note": "Motion explains a change of state and nothing else. Under prefers-reduced-motion every duration collapses to `instant` and transforms become opacity cross-fades (HIG Motion / Reduced Motion criteria)."
    },
    "duration-instant": "1ms",
    "duration-fast": "120ms",
    "duration-base": "180ms",
    "duration-slow": "280ms",
    "duration-sheet": "320ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in": "cubic-bezier(0.4, 0, 1, 1)"
  },

  "z": {
    "base": "0",
    "sticky": "10",
    "nav": "20",
    "popover": "30",
    "sheet": "40",
    "toast": "50"
  }
}

;; Metistry assistant — host confinement profile (open decision 15, the cost
;; it named). Under the `compose` shape the engine's isolation is the
;; container. Under the `launchd` shape it runs on the host, so the container
;; boundary is replaced by this one: deny by default, then allow exactly the
;; reads, the one writable directory, the one executable, and the two
;; network destinations the Agent SDK actually needs.
;;
;; Invoked by ops/launchd/com.foldedspacelabs.metistry.assistant.plist as
;;   /usr/bin/sandbox-exec -f <this file> -D KEY=VALUE … <node> <main.js>
;; so the sandbox is the job's root process and every child inherits it.
;;
;; Parameters (all absolute, all supplied by `metistry up`; see
;; packages/cli/src/sandbox.ts, which is the one place they are computed):
;;   NODE_PREFIX     the node installation root (read + exec)
;;   NODE_BIN        the node binary itself (read + exec)
;;   PRODUCT_DIR     the product checkout: dist/, node_modules/, seed/ (read only)
;;   STATE_DIR       the assistant's own state — HOME for the SDK's transcripts
;;                   (the ONLY writable location besides TMP_DIR)
;;   TMP_DIR         the per-user temporary directory
;;   CONFIG_IDENTITY        this instance's identity.yaml
;;   CONFIG_ASSISTANT_PROMPT  …its system-prompt template
;;   CONFIG_RULES           …its rules.yaml (the router's tier map)
;;   CONFIG_COMPUTE         …its compute.yaml
;;   CONFIG_SECRETS         …its secrets.yaml — names and policy, never a
;;                          value — so a provider key's grant is checked
;;                          before the engine dials (X-7)
;;                   Five FILES, not the directory holding them: see the
;;                   read rule below. Each falls back to the product's own
;;                   seed copy when this install has no instance directory.
;;   CONSOLE_TCP     the console's loopback endpoint, e.g. localhost:8080
;;   PROXY_TCP       the supervisor's egress proxy, e.g. localhost:7814 — the
;;                   ONLY route off this machine (see the network section)
;;   DB_TCP          Postgres' loopback endpoint, e.g. localhost:5432 — under
;;                   the compose shape the engine reached the db through the
;;                   container network, so this rule had no launchd twin and
;;                   the engine died at startup with EPERM (2026-09-10 trial)
;;
;; sandbox-exec(1) is deprecated by Apple and still functional (verified on
;; macOS 26.4; the same profile shape has worked since 14). It is a
;; deliberate stopgap: when the Mac app hosts this process (docs/product/
;; desktop-app-plan.md) the confinement becomes App Sandbox entitlements on
;; the bundled helper. That is a TRADE, not a pure upgrade, and this file
;; used to say otherwise: App Sandbox buys outbound filtering by host NAME,
;; and it costs the per-spawn `-D` parameterisation every rule below is
;; built on — entitlements are baked into a bundle's signature, so "this
;; instance's console port, this instance's five config files" is not
;; something they can express (docs/research/2026-09-19-agent-virtual-
;; filesystems.md §2.4). The host-name gap is closed TODAY by the egress
;; proxy below, without waiting for either. Recorded in
;; docs/ops/deployment-shapes.md and ops/sandbox/README.md.

(version 1)
(deny default)

;; Denials are reported to the system log either way — a violation we did
;; not predict is findable with
;;   log stream --predicate 'sender == "Sandbox"'
;; (SBPL rejects `(with report)` on a deny action, so this is a comment
;; rather than a rule.)

;; The base rules every macOS process needs to exist at all: dyld, the
;; shared cache, mach bootstrap, signals to itself, /dev/null and
;; /dev/urandom. Importing the system profile is what keeps this file about
;; Metistry's policy rather than about Darwin's plumbing.
(import "system.sb")

(allow process-fork)

;; ---- exec ---------------------------------------------------------------
;; The engine has no shell (invariant 9). The only executable it may run is
;; the node runtime — the Agent SDK spawns its own CLI as `node <cli.js>`.
(allow process-exec*
  (literal (param "NODE_BIN"))
  (subpath (param "NODE_PREFIX")))

;; ---- reads --------------------------------------------------------------
;; Metadata (lstat) on any path: node resolves its entry point by lstat-ing
;; every ancestor directory, so denying this denies startup itself. Metadata
;; is existence and size, never content — the file-read* allowlist below is
;; what actually governs what can be opened.
(allow file-read-metadata)

;; System frameworks, the certificate store, timezone and resolver config.
(allow file-read*
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/System")
  (subpath "/Library/Preferences/Logging")
  (subpath "/private/var/db/timezone")
  (subpath "/private/etc/ssl")
  (literal "/private/etc/hosts")
  (literal "/private/etc/resolv.conf")
  (literal "/private/etc/localtime")
  (literal "/private/etc/protocols")
  (literal "/private/etc/services"))

;; Its own code and runtime, read-only: the built dist/, node_modules/, and
;; the product's seed/ defaults. NOT the vault, NOT the instance repo, NOT
;; ~/Documents — the engine reaches knowledge through the brain bridge over
;; HTTP, never through the filesystem (D5).
(allow file-read*
  (literal (param "NODE_BIN"))
  (subpath (param "NODE_PREFIX"))
  (subpath (param "PRODUCT_DIR"))
  (subpath (param "STATE_DIR"))
  (subpath (param "TMP_DIR")))

;; …and this instance's own config: five FILES, by name.
;;
;; The engine is named by identity.yaml (the only place the assistant is
;; named at all), takes its system-prompt template, its tier map and its
;; model assignments from three more files, and reads every one of them off
;; disk through the D4 overlay. Before this rule the profile denied all four
;; — the overlay's instance half is an absolute path under the instance
;; directory — so the engine fell back to the product's SEED identity and
;; answered as someone else's assistant.
;;
;; A grant on the DIRECTORY that holds them would have been one line and is
;; refused on purpose: `<instance>/.metistry/` also holds the lock, the peer
;; registry and the whole Postgres cluster, and on an instance that has not
;; run `metistry migrate-layout` the machinery sits at the VAULT ROOT — so
;; the same line would hand the engine every note in the vault, which is the
;; one thing D5 says it may never read from disk. Five literals are the same
;; policy in both layouts and nothing more. Proven by the misuse test in
;; packages/cli/test/sandbox.test.ts: these five allowed, a note beside them
;; denied.
;;
;; The fifth, secrets.yaml, is the owner's policy for this instance's
;; secrets: which host each may be sent to and who may use it. It holds NO
;; value (its schema is strict; the values are in the login Keychain, which
;; this profile never reaches). The engine reads it so that a provider key
;; is attached only on the owner's grant to that provider (ruling 2 of the
;; W2 checkpoint, 2026-09-27) — a check the engine cannot make on a file it
;; cannot open.
(allow file-read*
  (literal (param "CONFIG_IDENTITY"))
  (literal (param "CONFIG_ASSISTANT_PROMPT"))
  (literal (param "CONFIG_RULES"))
  (literal (param "CONFIG_COMPUTE"))
  (literal (param "CONFIG_SECRETS")))

;; ---- writes -------------------------------------------------------------
;; Exactly two: the assistant's state directory (HOME — the SDK's session
;; transcripts live here) and the temporary directory.
(allow file-write*
  (subpath (param "STATE_DIR"))
  (subpath (param "TMP_DIR")))

;; ---- network ------------------------------------------------------------
;; Three destinations, and no fourth.
;;
;; 1. The console, on loopback. That is the whole tool surface: mcp-brain is
;;    mounted at the console's /mcp, so brain-commit and every allowlisted
;;    bridge call goes through this one endpoint.
(allow network-outbound (remote tcp (param "CONSOLE_TCP")))

;; 2. Postgres, on loopback. The engine holds its own pool (the invariant-3
;;    exception it shares with the watchdog), and the launchd shape's db is a
;;    user-space server on 127.0.0.1 rather than a container the process
;;    reached over the compose network. Exactly the one port `metistry up`
;;    put in the managed conf block — not a range, and not "loopback".
(allow network-outbound (remote tcp (param "DB_TCP")))

;; 3. The supervisor's egress proxy, on loopback — and NOT `*:443`.
;;
;;    This rule used to read `(allow network-outbound (remote tcp "*:443"))`
;;    with an honest note saying the host list was documentation rather than
;;    enforcement, because sandbox-exec filters by PORT and cannot express
;;    `openrouter.ai`. It still cannot. What closed the gap is the other
;;    half of the same sentence: the profile CAN be narrowed to one loopback
;;    port, and the thing listening there can name hosts all day.
;;
;;    So: the engine reaches one port, in the supervisor, and the CONNECT
;;    proxy on it admits exactly the hosts `metistry up` derived from this
;;    install's own compute.yaml (`engineHosts`) — authenticating the child
;;    with a bearer, refusing everything else with a `runs` row, and never
;;    decrypting a byte (CONNECT only, no TLS interception). The engine
;;    finds it as HTTPS_PROXY + NODE_USE_ENV_PROXY=1, which is what makes
;;    Node's global fetch honour it.
;;
;;    packages/core/src/egress.ts; apps/watchdog/src/egress-proxy.ts; the
;;    pattern is Anthropic's `sandbox-runtime`'s ("the Seatbelt profile
;;    allows communication only to a specific localhost port"), read from
;;    docs/research/2026-09-19-agent-virtual-filesystems.md §1.A — the
;;    pattern only: no dependency was added.
(allow network-outbound (remote tcp (param "PROXY_TCP")))

;; DNS resolution goes through mDNSResponder, not a socket to :53.
(allow network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder")))
(allow mach-lookup
  (global-name "com.apple.dnssd.service")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.SystemConfiguration.configd")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.SystemConfiguration.PPPController")
  (global-name "com.apple.SystemConfiguration.NetworkInformation")
  (global-name "com.apple.nehelper")
  (global-name "com.apple.networkd")
  (global-name "com.apple.usymptomsd"))

;; Reading the machine's own network/system state (node's os module, the
;; SDK's proxy detection).
(allow sysctl-read)
(allow system-socket)
;; A bind, not a listener: the engine opens no server. There is deliberately
;; no `network-inbound` rule, and on macOS 26 a `listen()` needs one (see
;; reconciler.sb's network section), so the engine cannot accept a
;; connection — ops/sandbox/bind.test.mjs asserts that too.
(allow network-bind (local ip "localhost:*"))

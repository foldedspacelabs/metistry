{
  "name": "@foldedspacelabs/metistry-connections",
  "version": "0.15.0",
  "description": "Metistry connections: the files in .metistry/connections/ read against the connection-type registry, and one pooled MCP client (stdio or Streamable HTTP) that refuses an unlisted tool before it dials, fills a secret only at egress to its listed hosts, never forwards the caller's own bearer, and redacts what comes back.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/foldedspacelabs/metistry.git", "directory": "packages/connections" },
  "homepage": "https://github.com/foldedspacelabs/metistry/tree/main/packages/connections",
  "bugs": "https://github.com/foldedspacelabs/metistry/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@foldedspacelabs/metistry-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}

{
  "name": "@foldedspacelabs/metistry-core",
  "version": "0.16.1",
  "description": "Metistry component contracts: manifest schema + runtime, check() interface, uniform error envelope, config-from-env, deterministic redaction, bridge caller auth. Usable standalone.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/foldedspacelabs/metistry.git", "directory": "packages/core" },
  "homepage": "https://github.com/foldedspacelabs/metistry/tree/main/packages/core",
  "bugs": "https://github.com/foldedspacelabs/metistry/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-env": {
      "types": "./dist/test-env.d.ts",
      "default": "./dist/test-env.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}

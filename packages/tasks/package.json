{
  "name": "@foldedspacelabs/metistry-tasks",
  "version": "0.12.0",
  "description": "A shared task list for heterogeneous agents: atomic claims, leases with heartbeat, dependency gating, idempotent create, append-only history. One TypeScript service over any pg-shaped client; adapters (HTTP, MCP, CLI) add nothing.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@foldedspacelabs/metistry-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
